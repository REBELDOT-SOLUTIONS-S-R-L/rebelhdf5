{
  "name": "myhdf5",
  "private": true,
  "version": "0.0.1",
  "description": "Online service to explore and visualise HDF5 files",
  "author": "European Synchrotron Radiation Facility",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitlab.esrf.fr/ui/myhdf5"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=10.26"
  },
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "desktop": "vite build && electron electron/main.cjs",
    "desktop:run": "electron electron/main.cjs",
    "desktop:install-launcher": "scripts/install_desktop_launcher.sh",
    "preview": "vite preview",
    "lint": "pnpm \"/^lint:/\"",
    "lint:eslint": "eslint --max-warnings=0",
    "lint:tsc": "tsc",
    "lint:prettier": "prettier --cache --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "analyze": "pnpm dlx source-map-explorer \"dist/assets/*.js\" --no-border-checks"
  },
  "dependencies": {
    "@h5web/app": "17.0.0",
    "@h5web/h5wasm": "17.0.0",
    "@react-hookz/web": "25.2.0",
    "@types/plotly.js": "3.0.10",
    "@types/react-plotly.js": "2.6.4",
    "h5wasm": "0.10.1",
    "h5wasm-plugins": "0.3.0",
    "modern-normalize": "3.0.1",
    "plotly.js": "3.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-dropzone": "15.0.0",
    "react-error-boundary": "6.1.1",
    "react-hook-form": "7.72.1",
    "react-icons": "5.6.0",
    "react-plotly.js": "2.6.0",
    "react-router-dom": "6.3.0",
    "suspend-react": "0.1.3",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@esrf/eslint-config": "2.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "@vitest/ui": "4.1.5",
    "electron": "41.5.0",
    "eslint": "9.39.4",
    "jsdom": "29.1.1",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "vite": "8.0.7",
    "vite-plugin-checker": "0.13.0",
    "vitest": "4.1.5"
  }
}
